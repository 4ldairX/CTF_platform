# Copy to .env and fill with REAL secrets (never commit .env)
# Generate SECRET_KEY:  python3 -c "import secrets; print(secrets.token_hex(48))"
# Generate DB password: python3 -c "import secrets; print(secrets.token_urlsafe(24))"

DATABASE_URL=postgresql+asyncpg://cyberquest:CHANGE_ME@localhost:5432/cyberquest
SECRET_KEY=CHANGE_ME_TO_64_HEX_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["https://yourdomain.com"]
ENV=production
MFA_ISSUER=CyberQuest
